# Copy to .env and fill in. SIMULATE=true runs the whole flow with no keys.

# --- Mode ---
# true  -> fake Devin client (sessions finish after a few polls, results are
#          prefixed "[SIMULATED]"), no GitHub reads or writes, issues enter via
#          POST /simulate/issue only.
# false -> real Devin + GitHub; the four credentials below are required.
SIMULATE=true

# --- Devin API (v3 organizations API) ---
# Service user key, starts with "cog_". https://docs.devin.ai/api-reference/authentication
DEVIN_API_KEY=
# Organization ID, starts with "org-".
DEVIN_ORG_ID=

# --- GitHub ---
# Token with repo scope on GITHUB_REPO (labels, comments, issue/PR reads).
GITHUB_TOKEN=
GITHUB_REPO=elen-dil/superset-ali
# Secret configured on the GitHub webhook. Used to verify X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=

# --- Issue labels ---
TRIGGER_LABEL=devin-remediate
RUNNING_LABEL=devin-running
PR_OPEN_LABEL=devin-pr-open
NEEDS_HUMAN_LABEL=devin-needs-human

# --- Guardrails ---
# Per-session ACU cap, passed to Devin as max_acu_limit.
MAX_ACU_PER_SESSION=10
# Sessions run in parallel; extra issues wait in the queue.
MAX_CONCURRENT_SESSIONS=3

# --- Timing (seconds) ---
SESSION_POLL_SECONDS=30
ISSUE_POLL_SECONDS=60
MERGE_CHECK_SECONDS=300
DISPATCH_SECONDS=5

# --- Storage ---
# Inside docker-compose this is under the ./data volume mount.
DATABASE_PATH=./data/autopilot.db

# --- Dashboard only ---
# Where the Streamlit dashboard finds the API.
FASTAPI_BASE_URL=http://localhost:8000
